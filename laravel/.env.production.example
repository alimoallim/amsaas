# Copy values into ECS task environment or AWS Secrets Manager.
# Never commit real secrets.

APP_NAME=AMSAAS
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://app.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=amsaas
DB_USERNAME=amsaas_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Optional S3 for invoice PDFs and uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=amsaas-prod-files
# FILESYSTEM_DISK=s3

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

EVC_WEBHOOK_ENABLED=false
EVC_WEBHOOK_SECRET=

SMS_ENABLED=false
SMS_DRIVER=log
SMS_PREFER_OVER_EMAIL=false
SMS_FROM="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=app.example.com
SESSION_DOMAIN=.example.com

# Set false on web tasks after first deploy; use `migrate` one-off task instead.
RUN_MIGRATIONS=false
RUN_STORAGE_LINK=true
